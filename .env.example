# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Auth & Session
SESSION_COOKIE_SECRET=a-long-random-string-for-cookies

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your-google-maps-api-key

# Razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Security & Gatepass
GATEPASS_SIGNING_SECRET=a-secure-secret-for-signing-qr-tokens

# Web Push (VAPID)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:support@kilari.in

# AI Configuration
# AI_PROVIDER can be 'rules' (deterministic) or 'anthropic' (LLM)
AI_PROVIDER=rules
ANTHROPIC_API_KEY=your-anthropic-api-key

# Provider Adapters
# KYC_PROVIDER can be 'mock' or 'digilocker'
KYC_PROVIDER=mock
# METER_PROVIDER can be 'mock' or 'smart-socket'
METER_PROVIDER=mock

# Demo Mode
# Set to 'true' to enable demo fallbacks for all external services
NEXT_PUBLIC_DEMO_MODE=true

# App Configuration
APP_URL=http://localhost:3000
